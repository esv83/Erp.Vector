<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication PROD (serveur IIS) pour Vector.Api.
  Cible : \\192.168.1.112\prod_api\Vector.Api
  Usage :  .\deploy.ps1 prod   (confirmation interactive, ou -Force en non-interactif)

  Strictement identique au profil DEV a la publishUrl pres : meme mode portable, meme
  DeleteExistingFiles=false, meme sequence app_offline. Seule la cible change.

  NB : le web.config (ASPNETCORE_ENVIRONMENT=Production + secrets __SET_VIA_ENV__) est gere
       MANUELLEMENT sur le serveur (csproj : IsTransformWebConfigDisabled=true) : la publication
       ne le regenere pas et ne l'ecrase pas.
  NB2 : appsettings.json EST ecrase par la publication (il fait partie de la sortie). Toute valeur
       specifique a la prod doit donc vivre dans appsettings.Production.json, qui est shippe et
       surcharge la base — c'est le cas pour Keycloak et AddressApi:BaseUrl.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- PAS de RuntimeIdentifier : publication PORTABLE (framework-dependent, lancée par
         « dotnet CaSoft.Erp.USVector.Api.dll » cf. web.config). Un RID win-x64 produit un deps.json
         RID-specific où Microsoft.Data.SqlClient charge sa façade « PlatformNotSupported » (la vraie
         impl reste dans runtimes/win et est ignorée) → « SqlClient is not supported on this platform ».
         En portable, le graphe RID résout runtimes/win/lib au runtime → SQL Server fonctionne. -->
    <SelfContained>false</SelfContained>
    <TargetFramework>net8.0</TargetFramework>
    <publishUrl>\\192.168.1.112\prod_api\Vector.Api</publishUrl>
    <!-- Sortie dirigée explicitement vers l'UNC (indépendamment du RID). -->
    <PublishDir>$(publishUrl)\</PublishDir>
    <!-- false : préserve web.config, le dossier logs\ et tout fichier posé à la main sur le serveur. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>

  <!-- Pose app_offline.htm avant la copie (libere les DLL verrouillees / coupe l'app
       proprement), puis le retire apres publication. -->
  <Target Name="AppOfflineStart" BeforeTargets="PrepareForPublish" Condition="'$(publishUrl)' != ''">
    <MakeDir Directories="$(publishUrl)" Condition="!Exists('$(publishUrl)')" />
    <WriteLinesToFile File="$(publishUrl)\app_offline.htm"
                      Lines="&lt;html&gt;&lt;body&gt;Mise a jour Vector.Api en cours...&lt;/body&gt;&lt;/html&gt;"
                      Overwrite="true" />
  </Target>
  <Target Name="AppOfflineStop" AfterTargets="Publish" Condition="'$(publishUrl)' != ''">
    <Delete Files="$(publishUrl)\app_offline.htm" />
  </Target>
</Project>
