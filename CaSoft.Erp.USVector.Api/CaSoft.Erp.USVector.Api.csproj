<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c17727bc-af06-4984-892a-030d09f4488e</UserSecretsId>
    <!-- Le web.config est géré manuellement sur le serveur (secrets dans <environmentVariables>).
         dotnet publish ne doit jamais le générer ni l'écraser. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Config NLog et appsettings : TOUJOURS copiés à la publication. En PreserveNewest (défaut du
         SDK Web, qui range *.config et *.json en Content), la copie vers le partage se fie aux
         horodatages et peut sauter un fichier sans un signal : la cible de la sonde de surface
         (27/08) n'était jamais arrivée en production (constaté le 19/09) ; un appsettings.json
         périmé fait refuser le démarrage (garde-fou KC-1). deploy.ps1 vérifie les deux après copie.
         ⚠️ C'est bien « Content » : un « None Update » serait sans effet, vérifié le 19/09. -->
    <Content Update="nlog.config;appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cycle du worker d'outbox testé sans attendre le poll (OperationalOutboxDispatcher.DispatchDueAsync). -->
    <InternalsVisibleTo Include="CaSoft.Erp.USVector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaSoft.Erp.USVector.Application\CaSoft.Erp.USVector.Application.vbproj" />
    <ProjectReference Include="..\CaSoft.Erp.USVector.Infrastructure\CaSoft.Erp.USVector.Infrastructure.csproj" />
    <ProjectReference Include="..\CaSoft.Erp.USVector.Contracts\CaSoft.Erp.USVector.Contracts.vbproj" />
    <ProjectReference Include="..\CaSoft.Erp.USVector.Domain\CaSoft.Erp.USVector.Domain.vbproj" />
    <ProjectReference Include="..\EmergencyPlatformConnector\EmergencyPlatformConnector.vbproj" />
    <ProjectReference Include="..\GpsGate.Connector\GpsGate.Connector.vbproj" />
  </ItemGroup>

</Project>
