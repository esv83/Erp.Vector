<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.49.0" />
    <PackageReference Include="CaSoft.Framework.Infrastructure" Version="2.3.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaSoft.Erp.USVector.Application\CaSoft.Erp.USVector.Application.vbproj" />
    <ProjectReference Include="..\CaSoft.Erp.USVector.Domain\CaSoft.Erp.USVector.Domain.vbproj" />
    <ProjectReference Include="..\CaSoft.Erp.USVector.Contracts\CaSoft.Erp.USVector.Contracts.vbproj" />
    <!-- Découplage 4a : plus de référence projet à Orders. Les données de référence ERP
         sont lues via Orders.Api (HTTP) — cf. ErpApi/HttpErpReadApiClient. -->
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose les membres internal aux tests (ex. JobRepository.SplitLabel). -->
    <InternalsVisibleTo Include="CaSoft.Erp.USVector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- G4 — Les scripts de schéma sont EMBARQUÉS : le catalogue des scripts attendus se déduit de
         l'assemblage (SchemaCatalogue), jamais d'une liste écrite à la main qu'on oublierait de
         tenir. Un script ajouté demain est attendu sans que personne y pense. -->
    <EmbeddedResource Include="Sql\*.sql" />
  </ItemGroup>

</Project>
